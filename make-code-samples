<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MakeCode Arcade Sample</title>
  <style>
    body {
      background-color: #1e1e1e;
      color: #ffffff;
      font-family: sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      margin: 0;
      padding: 20px;
    }
    .simulador {
      position: relative;
      width: 100%;
      max-width: 800px;
      height: 600px;
      border: 2px solid #444;
      border-radius: 8px;
      overflow: hidden;
    }
    iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: none;
    }
  </style>
</head>
<body>
  <h1>Meu Exemplo no MakeCode Arcade</h1>
  
  <div class="simulador">
    <!-- Substitua SEU-USUARIO e SEU-REPOSITORIO pelos dados do seu GitHub -->
    <iframe src="https://makecode.com" allowfullscreen="allowfullscreen" sandbox="allow-popups allow-forms allow-scripts allow-same-origin"></iframe>
  </div>
</body>
</html>
